# Free tier (Google AI Studio) -- no credit card required.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional second-tier news fallback. Free tier is 100 query units/month --
# only used if RSS (the primary source) fails to find anything, so
# this stays well within quota. Sign up at gdeltcloud.com/auth/sign-up,
# get a key at gdeltcloud.com/api-keys. Leave blank to skip this tier.
GDELT_CLOUD_API_KEY=gdelt_sk_your-key-here

# Not currently used -- kept here for when/if you later upgrade the
# assessment step from Gemini's free tier to Claude's paid API.
# ANTHROPIC_API_KEY=sk-ant-your-real-key-here
